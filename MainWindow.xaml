<Window x:Class="CAMTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAMTester — Camera Input Preview"
        Width="1180"
        Height="740"
        MinWidth="840"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="240" MaxWidth="460" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: CAMERA INPUTS -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Header & Refresh -->
                <Grid Grid.Row="0" Margin="2,2,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="6" Background="#1D3557" Margin="0,0,9,0">
                                <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                      Fill="#60A5FA"
                                      Stretch="Uniform"
                                      Width="15"
                                      Height="15" />
                            </Border>
                            <TextBlock Text="CAMTester"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CameraCountText"
                                   Text="Scanning camera inputs..."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Style="{StaticResource ToolbarButtonStyle}"
                            VerticalAlignment="Top"
                            Padding="10,6"
                            ToolTip="Re-scan connected camera inputs"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65,6.35A7.958,7.958 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filter Input -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource DarkTextBoxStyle}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Filter cameras..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <!-- Camera List -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="CameraListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CameraListItemStyle}"
                             SelectionChanged="CameraListBox_SelectionChanged"
                             PreviewMouseLeftButtonUp="CameraListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding DeviceId}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Camera Index Badge -->
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="7"
                                            Background="#121620"
                                            BorderBrush="#2C3345"
                                            BorderThickness="1"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#93C5FD" />
                                    </Border>

                                    <!-- Name & Metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Indicator Arrow -->
                                    <Path Grid.Column="2"
                                          Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="{StaticResource TextMutedBrush}"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty Sidebar State -->
                    <StackPanel x:Name="NoCamerasPanel"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16">
                        <Path Data="M3.27,2L2,3.27L4.73,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16C16.2,18 16.39,17.92 16.54,17.82L19.73,21L21,19.73M21,6.5L17,10.5V7A1,1 0 0,0 16,6H9.82L21,17.18V6.5Z"
                              Fill="{StaticResource TextMutedBrush}"
                              Width="36"
                              Height="36"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock x:Name="NoCamerasTitle"
                                   Text="No cameras found"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="NoCamerasSubtitle"
                                   Text="Connect a USB webcam or virtual camera, then click Refresh."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Footer Tip -->
                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="#12151E"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <TextBlock Text="Click any camera input to preview its live feed. Devices update automatically on plug/unplug."
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Vertical Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderSubtleBrush}"
                      ResizeBehavior="PreviousAndNext" />

        <!-- RIGHT MAIN PANE: PREVIEW STAGE -->
        <Grid Grid.Column="2" Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Selected Camera Heading + Status Pill -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCameraTitle"
                                   Text="No camera selected"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />

                        <Border x:Name="StatusBadge"
                                Margin="10,0,0,0"
                                Padding="8,3"
                                CornerRadius="10"
                                Background="#1F2430"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource TextMutedBrush}"
                                         Margin="0,0,6,0" />
                                <TextBlock x:Name="StatusBadgeText"
                                           Text="IDLE"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SharedModeBadge"
                                Visibility="Collapsed"
                                Margin="6,0,0,0"
                                Padding="7,3"
                                CornerRadius="10"
                                Background="#2E2514"
                                BorderBrush="#6B4F1D"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ToolTip="Another application holds exclusive camera control; previewing in read-only shared mode.">
                            <TextBlock Text="SHARED"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#FCD34D" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Preview Action Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="FormatComboBox"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="225"
                              Margin="0,0,8,0"
                              IsEnabled="False"
                              ToolTip="Select stream resolution and frame rate"
                              SelectionChanged="FormatComboBox_SelectionChanged" />

                    <ToggleButton x:Name="MirrorToggle"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Content="Mirror"
                                  Margin="0,0,8,0"
                                  ToolTip="Flip preview horizontally"
                                  Click="MirrorToggle_Click" />

                    <Button x:Name="SnapshotButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="Snapshot"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            ToolTip="Save current frame as a PNG image"
                            Click="SnapshotButton_Click" />

                    <Button x:Name="StopButton"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="Stop"
                            IsEnabled="False"
                            ToolTip="Stop live preview and release the camera"
                            Click="StopButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Video Viewport -->
            <Border Grid.Row="1"
                    Background="{StaticResource ViewportBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <!-- Live Camera Preview Image -->
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="Collapsed">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="PreviewMirrorTransform" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>

                    <!-- Idle / Welcome Overlay -->
                    <StackPanel x:Name="IdleOverlay"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="400">
                        <Border Width="64"
                                Height="64"
                                CornerRadius="16"
                                Background="#151924"
                                BorderBrush="#262C3D"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                  Fill="#4B5563"
                                  Width="30"
                                  Height="30"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Ready to preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Click any camera input in the sidebar to start its live video preview."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <StackPanel x:Name="LoadingOverlay"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="180"
                                     Height="4"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#1F2430"
                                     BorderThickness="0"
                                     Margin="0,0,0,14" />
                        <TextBlock x:Name="LoadingText"
                                   Text="Opening camera stream..."
                                   FontSize="13.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Error Overlay -->
                    <Border x:Name="ErrorOverlay"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="460"
                            Padding="24"
                            CornerRadius="10"
                            Background="#19151A"
                            BorderBrush="#5C262B"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Unable to start camera preview"
                                       FontSize="15.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FCA5A5"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="ErrorMessageText"
                                       Text="An error occurred while opening this camera."
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,16" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Content="Retry"
                                        Padding="16,7"
                                        Click="RetryButton_Click" />
                                <Button x:Name="PrivacySettingsButton"
                                        Visibility="Collapsed"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Content="Open Camera Privacy Settings"
                                        Margin="8,0,0,0"
                                        Click="PrivacySettingsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Subtle Toast Overlay (e.g., Snapshot saved / Device ID copied) -->
                    <Border x:Name="ToastBanner"
                            Visibility="Collapsed"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"
                            Padding="14,8"
                            CornerRadius="8"
                            Background="#E61C2230"
                            BorderBrush="#3B82F6"
                            BorderThickness="1">
                        <TextBlock x:Name="ToastText"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Telemetry Bar -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RESOLUTION" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TelemetryResolution" Text="—" FontSize="12" FontWeight="Medium" Margin="6,0,18,0" VerticalAlignment="Center" />

                        <TextBlock Text="FPS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TelemetryFps" Text="—" FontSize="12" FontWeight="Medium" Margin="6,0,18,0" VerticalAlignment="Center" />

                        <TextBlock Text="FORMAT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TelemetryFormat" Text="—" FontSize="12" FontWeight="Medium" Margin="6,0,18,0" VerticalAlignment="Center" />

                        <TextBlock Text="MODE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TelemetryMode" Text="—" FontSize="12" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="CopyIdButton"
                            Grid.Column="2"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="Copy Device ID"
                            Padding="10,4"
                            FontSize="11.5"
                            IsEnabled="False"
                            Click="CopyIdButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
